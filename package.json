{
  "name": "gestion-universitaire",
  "version": "1.2.0",
  "description": "Application de gestion universitaire - étudiants, professeurs, cours, notes, bulletins, absences, emploi du temps, finances, bibliothèque",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "UniGest",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "sql.js": "^1.10.0"
  },
  "build": {
    "appId": "com.universite.unigest",
    "productName": "UniGest",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ipc.js",
      "db/database.js",
      "db/seed.js",
      "renderer/**"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UniGest"
    }
  }
}
